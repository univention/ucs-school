#!/bin/sh
# -*- coding: utf-8 -*-
#
# Univention Management Console Module schoolexam
#  join script
#
# SPDX-FileCopyrightText: 2013-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=1

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh
. /usr/share/ucs-school-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "schoolexam-all" "Start exam" "" "schoolexam/*"

# create empty UMC access policies
ucs_school_policies_create

# default policies for all operations (for admins)
umc_policy_append "default-umc-all" "schoolexam-all"
# policy for school admins
umc_policy_append "ucsschool-umc-admins-default" "schoolexam-all"
# policy for teachers
umc_policy_append "ucsschool-umc-teachers-default" "schoolexam-all"

joinscript_save_current_version

exit 0
