## joinscript api: bindpwdfile

# shellcheck disable=SC2034
VERSION=1

# shellcheck disable=SC1091
. /usr/share/univention-join/joinscripthelper.lib

joinscript_init


LUSD_LIMBO_NAME="lusd-limbo"


if ! univention-ldapsearch -LLL ou="$LUSD_LIMBO_NAME" dn | grep -q "$LUSD_LIMBO_NAME"; then
    /usr/share/ucs-school-import/scripts/create_ou "$LUSD_LIMBO_NAME"
fi


joinscript_save_current_version

exit 0
