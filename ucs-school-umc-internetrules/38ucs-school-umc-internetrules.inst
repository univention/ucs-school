#!/bin/sh
# -*- coding: utf-8 -*-
#
# Univention Management Console Module internetrules
#  join script
#
# SPDX-FileCopyrightText: 2012-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=1

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh
. /usr/share/ucs-school-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "internetrules-all" "Manage internet rules" "" "internetrules/*"

# create empty UMC access policies
ucs_school_policies_create

# policy for admins (not allowed to teachers)
for ipol in ucsschool-umc-admins-default default-umc-all; do
	umc_policy_append "$ipol" "internetrules-all"
done

joinscript_save_current_version

exit 0


