#DEBHELPER#

BASE_DIR="/var/lib/ram-performance-tests/"


python3 -m venv --system-site-packages "$BASE_DIR/venv"
"$BASE_DIR/venv/bin/pip" install -U pip wheel
"$BASE_DIR/venv/bin/pip" install -U locust==2.12.1 pydantic==1.10.2 diskcache==5.4.0 faker==15.1.1
rm -rf "$BASE_DIR/build/"

exit 0
