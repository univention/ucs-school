#!/bin/sh
# shellcheck disable=SC2016
set -e -u

exec >generated-config-doc.yml
cat "${0%/*}/base.yml"
cat "${0%/*}/base-doc.yml"

doc_job () { # <extends> [<suffix> [<language>]]
    echo
    echo "build ${pkg}${3:+ "$3"}${2:+ "$2"}:"
    echo '  variables:'
    echo "    DOCS_DIR: $path"
    echo "    DOC_TARGET_NAME: ${path##*/}"
    [ -n "${3+empty}" ] && echo "    language: $3"

    if [ "$pkg" = "ucsschool-changelog" ] && ( [ "$2" = "html" ] || [ "$2" = "pdf" ] )
    then
        echo '    DOC_TARGET_VERSION: $CHANGELOG_TARGET_VERSION'
    fi
    echo '    DOC_TARGET_PATH: $DOC_TARGET_NAME/$DOC_TARGET_VERSION/$language'
    echo "  extends: ${1:?extends}"
    echo '  rules:'
    echo '    - changes:'
    echo "      - ${path}/**/*"
    echo '      - doc/errata/**/*'
    if [ "$pkg" != "ucsschool-changelog" ]
    then
        echo '      - doc/ucsschool-changelog/**/*'
    fi
    echo '      - doc/bibliography-de.bib'
    echo '      - doc/substitutions-de.txt'
}

document_paths () {
    for p in doc/*/conf.py
    do
        [ -f "$p" ] || continue
        path="${p%/conf.py}"
        echo "      - $path/**/*"
    done
}

merge_one_artifact () {
    echo
    echo 'docs-merge-to-one-artifact:'
    echo '  extends: .sphinx-merge-template'
    echo '  script:'
    echo '    - !reference [.sphinx-merge-template, script]'
    echo '    - sed -i "s|/artifacts/out/.*|/artifacts/out/index.html|" doc.env'
    echo '    - |'
    echo "      cat >docs-index <<'DOCS_INDEX'"
    sed 's/^/      /' "${0%/*}/docs-index"
    echo '      DOCS_INDEX'
    echo '    - sh docs-index out'
    echo '  rules:'
    echo '    - changes:'
    document_paths
}

review_environment () {
    echo
    echo 'docs-review:'
    echo '  extends: .sphinx-review-template'
    echo '  image: ${CI_DEPENDENCY_PROXY_GROUP_IMAGE_PREFIX}/busybox:latest'
    echo '  variables:'
    echo '    GIT_STRATEGY: none'
    echo '  needs:'
    echo '    - job: docs-merge-to-one-artifact'
    echo '  environment:'
    echo '    on_stop: docs-review-stop'
    echo '    auto_stop_in: 1 week'
    echo '  rules:'
    echo '    - if: $PARENT_CI_PIPELINE_SOURCE == "merge_request_event"'
    echo '      changes:'
    document_paths
    echo
    echo 'docs-review-stop:'
    echo '  stage: merge'
    echo '  image: ${CI_DEPENDENCY_PROXY_GROUP_IMAGE_PREFIX}/busybox:latest'
    echo '  variables:'
    echo '    GIT_STRATEGY: none'
    echo '  needs:'
    echo '    - job: docs-review'
    echo '      artifacts: false'
    echo '  script:'
    echo '    - "true"'
    echo '  environment:'
    echo '    name: review/docs/$CI_COMMIT_REF_SLUG'
    echo '    action: stop'
    echo '  allow_failure: true'
    echo '  rules:'
    echo '    - if: $PARENT_CI_PIPELINE_SOURCE == "merge_request_event"'
    echo '      changes:'
    document_paths
    echo '      when: manual'
}

create_production_merge_request () {
    echo
    echo 'docs-create-production-merge-request:'
    echo '  extends: .sphinx-docs-merge-request-template'
    echo '  needs:'
    echo '    - job: docs-merge-to-one-artifact'
    echo '  rules:'
    echo '    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $PARENT_CI_PIPELINE_SOURCE == "push"'
    echo '      changes:'
    document_paths
    echo '      when: manual'
    echo '    - if: $FORCE_DOCS == "yes"'
    echo '      when: manual'
    echo '    - if: "$CI_COMMIT_TAG"'
    echo '      when: manual'
}

for make in doc/*/Makefile
do
    [ -f "$make" ] || continue
    path="${make%/Makefile}"
    pkg="${path##*/}"

    # Automatically detect Sphinx or Docbook
    if [ -f "${path}/conf.py" ] # Use Sphinx's conf.py as hint to Sphinx
    then
        if [ "$pkg" = "ucsschool-changelog" ]
        then
            lang_default="en"
        else
            lang_default="de"
        fi

        for l_path in "$path"/locales/* "$lang_default"
        do
            language="${l_path##*/}"
            [ "$language" = '*' ] && continue
            doc_job '.sphinx-html' html "$language"
            doc_job '.sphinx-pdf' pdf "$language"
            doc_job '.sphinx-linkcheck' linkcheck "$language"
            doc_job '.sphinx-spelling' spelling "$language"
        done
    fi
done
merge_one_artifact
review_environment
create_production_merge_request
