#!/bin/sh
# -*- coding: utf-8 -*-
#
# Univention Management Console Module schoollists
#  join script
#
# SPDX-FileCopyrightText: 2018-2025 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only


## joinscript api: bindpwdfile

VERSION=1

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh
. /usr/share/ucs-school-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "schoollists-all" "Class Lists" "" "schoollists/*"

# create empty UMC access policies
ucs_school_policies_create

# default policies for all operations (for admins)
umc_policy_append "default-umc-all" "schoollists-all"
# policy for school admins
umc_policy_append "ucsschool-umc-admins-default" "schoollists-all"
# policy for teachers
umc_policy_append "ucsschool-umc-teachers-default" "schoollists-all"

joinscript_save_current_version

exit 0
