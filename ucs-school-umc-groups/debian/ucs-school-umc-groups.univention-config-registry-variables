[ucsschool/assign-classes/autosearch]
Description[de]=De-/Aktiviert die automatische Suche beim öffnen des Modul "Klassen zuordnen".
Description[en]=De-/activates the automatic search when opening the module "Assign classes".
Type=bool
Categories=management-umc

[ucsschool/assign-classes/autosearch_on_change]
Description[de]=Definiert ob bei jeder Änderung der Schule die Liste automatisch neu geladen werden soll im Modul "Klassen zuordnen".
Description[en]=Defines if the list should be reloaded automatically after a change in the school selection in the module "Assign classes".
Type=bool
Categories=management-umc
Default=true

