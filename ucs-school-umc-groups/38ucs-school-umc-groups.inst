#!/bin/sh
# -*- coding: utf-8 -*-
#
# Univention Management Console Module school-groups
#  join script
#
# SPDX-FileCopyrightText: 2012-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=4

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh
. /usr/share/ucs-school-lib/umc.sh

joinscript_init

umc_init

# operation sets for admins (class and workgroup administration) and teachers
# (only the workgroup administration or editing)
umc_operation_create "schoolgroups-all" "Group administration" "" "schoolgroups/*"
umc_operation_create "schoolgroups-workgroup-admin" "Workgroup administration" "workgroup-admin" "schoolgroups/*"
umc_operation_create "schoolgroups-class" "Class administration" "class" "schoolgroups/*"
umc_operation_create "schoolgroups-teacher" "Teacher administration" "teacher" "schoolgroups/*"
umc_operation_create "schoolgroups-workgroup" "Workgroup editing" "workgroup" "schoolgroups/query" "schoolgroups/groups" "schoolgroups/classes" "schoolgroups/users" "schoolgroups/schools" "schoolgroups/put" "schoolgroups/get"

# umc_operation_create skips existing sets, so add commands introduced later explicitly.
workgroup_operation_add () {
	command="$1"
	dn="cn=schoolgroups-workgroup,cn=operations,cn=UMC,cn=univention,$ldap_base"
	operations="$(univention-ldapsearch -LLL -o ldif-wrap=no -s base -b "$dn" umcOperationSetCommand |
		sed -ne 's/^umcOperationSetCommand: //p')"
	# not replicated yet: this run created the set, so it already contains the command
	[ -n "$operations" ] || return 0
	# any UDM edit of the set stores "command:"
	printf '%s\n' "$operations" | grep -qxF -e "$command" -e "$command:" && return 0
	# repeated --set keeps the stored commands as they are; --append rewrites them all as "command:"
	set --
	while read -r operation; do
		set -- "$@" --set operation="$operation"
	done <<-EOF
		$operations
	EOF
	umc_udm settings/umc_operationset modify --dn "$dn" "$@" --set operation="$command" || exit $?
}
workgroup_operation_add "schoolgroups/groups"

# create empty UMC access policies
ucs_school_policies_create

umc_policy_append "default-umc-all" "schoolgroups-all"
# policy for school admins (not allowed to teachers)
umc_policy_append "ucsschool-umc-admins-default" "schoolgroups-workgroup-admin" "schoolgroups-class" "schoolgroups-teacher"
# policy for teachers
umc_policy_append "ucsschool-umc-teachers-default" "schoolgroups-workgroup" "schoolgroups-workgroup-admin"

joinscript_save_current_version

exit 0
