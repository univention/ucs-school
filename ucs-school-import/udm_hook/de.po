#: udm_hook/ucsschool_user_options.py:58
#, python-format
msgid ""
"%(option)s cannot be activated together with %(illegals)s."
msgstr ""
"%(option)s kann nicht zusammen mit %(illegals)s aktiviert werden."

#: udm_hook/ucsschool_legal_ward.py
#, python-format
msgid ""
"This legal guardian already has %(num_legal_wards)d "
"legal wards. Adding more would increase it above the maximum "
"allowed legal wards of (%(max_legal_wards)d)."
msgstr "Der Sorgeberechtigte hat bereits %(num_legal_wards)d Schüler. Das Hinzufügen weiterer überschreitet die maximal erlaubte Anzahl an Schülern (%(max_legal_wards)d)."

#: udm_hook/ucsschool_legal_ward.py
#, python-format
msgid ""
"This legal ward %(self_dn)s would have %(num_legal_guardians)d "
"legal guardians, which is above the maximum allowed number of "
"legal guardians (%(max_legal_guardians)d)."
msgstr ""
"Dieser Schüler hätte %(num_legal_guardians)d "
"Sorgeberechtigte, was über der maximal zulässigen Anzahl von "
"Schülern (%(max_legal_guardians)d) liegt."

#: udm_hook/ucsschool_legal_guardian.py
#, python-format
msgid ""
"Legal guardian %(self_dn)s would have %(num_of_wards)d legal wards, "
"which is above the maximum allowed number of legal wards (%(max_legal_wards)d)."
msgstr ""
"Sorgeberechtigter %(self_dn)s würde %(num_of_wards)d Schüler haben, "
"was über der maximal erlaubten Anzahl von Schülern (%(max_legal_wards)d) liegt."

#: udm_hook/ucsschool_legal_guardian.py
#, python-format
msgid ""
"Legal ward %(student_dn)s already has %(num_legal_guardians)d legal guardians. "
"Adding %(self_dn)s would increase it above the maximum allowed "
"legal guardians (%(max_legal_guardians)d)."
msgstr ""
"Schüler %(student_dn)s hat bereits %(num_legal_guardians)d Erziehungsberechtigte. "
"Das Hinzufügen von %(self_dn)s würde die zulässige Anzahl Sorgeberechtigter überschreiten (%(max_legal_guardians)d)."
