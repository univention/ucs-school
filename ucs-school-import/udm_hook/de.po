#: ucsschool_user_options.py:66
#, python-format
msgid "%(option)s cannot be activated together with %(illegals)s."
msgstr "%(option)s kann nicht zusammen mit %(illegals)s aktiviert werden."

#: ucsschool_legal_ward.py:81
#, python-format
msgid "The specified user %(dn)s is no legal guardian."
msgstr "Der angegebene Benutzer %(dn)s ist kein Sorgeberechtigter."

#: ucsschool_legal_guardian.py:132
#, python-format
msgid "The specified user %(dn)s is no student."
msgstr "Der angegebene Benutzer %(dn)s ist kein Schüler."

#: ucsschool_legal_ward.py:94
#, python-format
msgid ""
"This legal guardian already has %(num_legal_wards)d assigned students. Adding more "
"would increase it above the maximum allowed number of assigned students "
"(%(max_legal_wards)d)."
msgstr ""
"Der Sorgeberechtigte hat bereits %(num_legal_wards)d zugeordnete Schüler. Das Hinzufügen "
"weiterer würde die maximal zulässige Anzahl an zugeordneten Schülern "
"(%(max_legal_wards)d) überschreiten."

#: ucsschool_legal_ward.py:130
#, python-format
msgid ""
"This student would have %(num_legal_guardians)d assigned legal guardians, which is "
"above the maximum allowed number of assigned legal guardians "
"(%(max_legal_guardians)d)."
msgstr ""
"Dieser Schüler würde %(num_legal_guardians)d zugeordnete Sorgeberechtigte haben, was "
"über der maximal zulässigen Anzahl an zugeordneten Sorgeberechtigten "
"(%(max_legal_guardians)d) liegt."

#: ucsschool_legal_guardian.py:101
#, python-format
msgid ""
"This legal guardian would have %(num_of_wards)d assigned students, which is "
"above the maximum allowed number of assigned students (%(max_legal_wards)d)."
msgstr ""
"Dieser Sorgeberechtigte würde %(num_of_wards)d zugeordnete Schüler haben, was über "
"der maximal zulässigen Anzahl an zugeordneten Schülern (%(max_legal_wards)d) liegt."

#: ucsschool_legal_guardian.py:142
#, python-format
msgid ""
"This student already has %(num_legal_guardians)d assigned legal "
"guardians. Adding more would increase it above the maximum allowed "
"number of assigned legal guardians (%(max_legal_guardians)d)."
msgstr ""
"Der Schüler hat bereits %(num_legal_guardians)d zugeordnete "
"Sorgeberechtigte. Das Hinzufügen weiterer würde die zulässige "
"Anzahl an zugeordneten Sorgeberechtigten (%(max_legal_guardians)d) überschreiten."
