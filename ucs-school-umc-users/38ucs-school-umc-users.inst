#!/bin/sh
# -*- coding: utf-8 -*-
#
# Univention Management Console Module schoolusers
#  join script
#
# SPDX-FileCopyrightText: 2012-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=1

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/umc.sh
. /usr/share/ucs-school-lib/umc.sh

joinscript_init

umc_init
umc_operation_create "schoolusers-all" "Reset passwords" "" "schoolusers/*"
umc_operation_create "schoolusers-student" "Students (passwords)" "student" "schoolusers/*"

# create empty UMC access policies
ucs_school_policies_create

# policy for admins
for ipol in ucsschool-umc-admins-default default-umc-all; do
	umc_policy_append "$ipol" "schoolusers-all"
done

# policy for teachers
umc_policy_append "ucsschool-umc-teachers-default" "schoolusers-student"

joinscript_save_current_version

exit 0
